{
  "id": "zed",
  "name": "Zed",
  "tagline": "High-performance multiplayer code editor",
  "description": "A high-performance, collaborative code editor from the creators of Atom and Tree-sitter. Built in Rust with GPU-accelerated rendering for instant responsiveness and built-in real-time collaboration.",
  "website": "https://zed.dev",
  "repository": "https://github.com/zed-industries/zed",
  "license_spdx": "GPL-3.0-or-later",
  "category": "developer-tools",
  "tags": ["code-editor", "ide", "rust", "collaboration", "vscode-alternative"],
  "capabilities": [
    "gpu-accelerated",
    "real-time-collaboration",
    "language-server-protocol",
    "ai-integration"
  ],
  "import_export_formats": [".json"],
  "platforms": ["macOS", "Linux"],
  "pricing": {
    "model": "free_open_source",
    "has_paid_tier": false
  },
  "privacy": {
    "telemetry": false,
    "offline_usable": true,
    "cloud_sync_required": false
  },
  "self_hosting": {
    "supported": false
  },
  "installation": {
    "macOS": "brew install --cask zed",
    "Linux": "snap install zed-editor"
  },
  "replaces": [
    {
      "target": "vscode",
      "migration_ease": "moderate",
      "import_supported": true,
      "notes": "VS Code keybinding and extension import available. GPU-accelerated performance advantage."
    }
  ],
  "security": {
    "verified_publisher": true,
    "last_audit_date": "2026-08-02"
  },
  "health_status": "healthy"
}
